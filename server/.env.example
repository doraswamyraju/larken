# Larken Technologies LLC - Server Environment Variables

PORT=5092
NODE_ENV=production

# Database Configuration (PostgreSQL on Hostinger VPS)
DATABASE_URL=postgresql://larken_user:secure_password@localhost:5432/larken_db
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=larken_db
PG_USER=larken_user
PG_PASSWORD=secure_password

# Authentication & Admin
JWT_SECRET=super_secret_jwt_key_change_in_production
ADMIN_DEFAULT_EMAIL=contracts@larkenit.com
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately123!

# ==============================================================================
# Email Notifications -> Lead delivery to contracts@larkenit.com
# ==============================================================================
# The customer's primary inbox is hosted on ZenBusiness (HostedEmail).
# Incoming mail is handled by ZenBusiness MX records and will NEVER be disturbed.
#
# Choose ONE of the following options to deliver contact form submissions:
#
# OPTION A: Using ZenBusiness SMTP (if customer provides mailbox password)
#   SMTP_HOST=mail.b.hostedemail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contracts@larkenit.com
#   SMTP_PASS=customer_zenbusiness_email_password
#
# OPTION B: Using Hostinger VPS SMTP / Transactional Mailer (Zero disturbance to ZenBusiness)
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your_hostinger_or_external_mail_user
#   SMTP_PASS=your_mail_password
#
# OPTION C: Using Gmail / Google Workspace SMTP
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_gmail_app_password
#
# All leads are automatically delivered to:
NOTIFICATION_RECEIVER=contracts@larkenit.com

SMTP_HOST=mail.b.hostedemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contracts@larkenit.com
SMTP_PASS=your_email_password

# File Storage
UPLOAD_DIR=./uploads/resumes
